# ============================================
# VARIABLES À CONFIGURER MANUELLEMENT SUR RENDER
# ============================================

# ---- APPLICATION ----
# Générer avec: php artisan key:generate --show
# Ou laisser Render générer automatiquement
APP_KEY=base64:VOTRE_CLE_GENEREE_ICI

# Remplacer par votre URL Render (ex: https://lesprosdelacomm.onrender.com)
APP_URL=https://votre-app.onrender.com

# ---- CONFIGURATION EMAIL (OBLIGATOIRE pour contact et membership) ----
# Choisir un service SMTP (Mailgun, SendGrid, Gmail, etc.)

# Exemple avec Mailgun:
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=postmaster@votre-domaine.mailgun.org
MAIL_PASSWORD=votre-mailgun-api-key
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@lesprosdelacomm.com
MAIL_FROM_NAME="Les Pros De La Com"

# Exemple avec SendGrid:
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=votre-sendgrid-api-key
# MAIL_ENCRYPTION=tls

# Exemple avec Gmail:
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=votre-email@gmail.com
# MAIL_PASSWORD=votre-app-password-gmail
# MAIL_ENCRYPTION=tls

# ============================================
# VARIABLES AUTO-CONFIGURÉES PAR render.yaml
# (Ne pas modifier manuellement)
# ============================================

APP_NAME=LesProsDelaCom
APP_ENV=production
APP_DEBUG=false

LOG_CHANNEL=errorlog
LOG_LEVEL=info

# Base de données PostgreSQL (auto-configurée)
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public
BROADCAST_CONNECTION=log
